{
    "homepage": "https://riot.im/download/desktop/",
    "description": "Legacy Riot Desktop Matrix client. Riot was renamed to Element; use element-desktop for maintained releases.",
    "license": "Apache-2.0",
    "version": "1.6.8",
    "architecture": {
        "64bit": {
            "url": "https://packages.element.io/desktop/install/win32/x64/Riot%20Setup%201.6.8.exe#/dl.7z",
            "hash": "343087b189c3537da580cc40b670b63785ea628833c4ab5f3d1c62313c3c72c2"
        }
    },
    "pre_install": [
        "extract_7zip \"$dir\\riot-web-*-full.nupkg\" \"$dir\\temp\"",
        "Copy-Item \"$dir\\temp\\lib\\net45\\*\" \"$dir\" -Recurse -Force",
        "Remove-Item \"$dir\\riot-web-*-full.nupkg\"",
        "Remove-Item \"$dir\\temp\" -Recurse -Force",
        "Remove-Item \"$dir\\background.gif\" -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\RELEASES\" -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\Update.exe\" -ErrorAction SilentlyContinue"
    ],
    "bin": "Riot.exe",
    "shortcuts": [
        [
            "Riot.exe",
            "Riot"
        ]
    ],
    "checkver": {
        "url": "https://packages.element.io/desktop/install/win32/x64/index.html",
        "regex": "Riot Setup ([\\d.]+)\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://packages.element.io/desktop/install/win32/x64/Riot%20Setup%20$version.exe#/dl.7z"
            }
        }
    }
}
